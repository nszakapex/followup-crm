# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL
# Use the production origin for deployed auth callbacks and tracked review links.
# For local LAN testing, Supabase redirect URLs must also include the LAN origin.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Review delivery safety
# Local development skips delivery by default. Keep these true for local/demo mode;
# set both false only when intentionally testing live provider delivery.
REVIEW_REQUEST_TEST_MODE=true
REVIEW_REQUEST_SKIP_DELIVERY=true

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Legacy fallback still supported by the app.
TWILIO_PHONE_NUMBER=

# Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Admin
# Optional: email address used by future admin bootstrapping/manual checks.
ADMIN_EMAIL=

# Automation runner
# Server-only secret for POST /api/automations/run and /api/automations/scheduled-run.
# Use a long random value. Do not prefix with NEXT_PUBLIC_.
# Required for automation run endpoints; missing config disables authorized runs.
AUTOMATION_RUN_SECRET=
# Optional server-only fallback if a hosting platform already provides it.
CRON_SECRET=
# Optional cap for scheduled-run business batches. Hard maximum is 25.
AUTOMATION_SCHEDULER_MAX_BUSINESSES=10
