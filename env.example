# Core Supabase app configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct database URL for Supabase CLI/migrations or external tooling.
DATABASE_URL=

# Public app URL
# APP_URL is server-side. NEXT_PUBLIC_APP_URL/NEXT_PUBLIC_SITE_URL are safe public origins
# used for auth callbacks and customer-facing links.
APP_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Supabase Auth uses project settings for email auth. These aliases are included
# for deployment checklists that expect NextAuth-style names; this app does not
# use NextAuth.
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Business defaults used during setup/documentation. Runtime business identity is
# stored per business in Supabase after signup/onboarding.
BUSINESS_NAME=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_TIMEZONE=America/Denver

# Resend email - required for v1 owner lead notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_NOTIFY_EMAIL=
# Legacy/alternate name accepted by the app.
NOTIFICATION_EMAIL=

# Generic inbound lead webhook - required for Zapier/Make/forms.
INBOUND_WEBHOOK_SECRET=
# Recommended for production single-business deployments. If omitted, the app
# can only infer a business when exactly one business exists.
INBOUND_WEBHOOK_BUSINESS_ID=
# Legacy alias accepted by the app.
WEBHOOK_SECRET=
WEBHOOK_BUSINESS_ID=

# Review delivery safety
# Local development skips review-request delivery by default. Set both false only
# when intentionally validating one live provider/channel.
REVIEW_REQUEST_TEST_MODE=true
REVIEW_REQUEST_SKIP_DELIVERY=true

# SMS is optional for v1 and disabled by default.
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_COMPLIANCE_APPROVED=false
SMS_COMPLIANCE_STATUS=

# Optional Twilio SMS adapter. Only required when SMS_ENABLED=true and
# SMS_PROVIDER=twilio. Missing values must not break lead capture or email.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_PHONE_NUMBER=
TWILIO_A2P_CAMPAIGN_STATUS=
TWILIO_WEBHOOK_VALIDATE_SIGNATURE=false

# Optional admin/bootstrap marker.
ADMIN_EMAIL=

# Automation runner
# Server-only secret for POST /api/automations/run and
# /api/automations/scheduled-run. These routes do not send providers.
AUTOMATION_RUN_SECRET=
CRON_SECRET=
AUTOMATION_SCHEDULER_MAX_BUSINESSES=10
